# Chep thanh .env roi sua. KHONG commit file .env that.
BINANCE_ENV=testnet
BINANCE_API_KEY=
BINANCE_API_SECRET=
MAX_GROSS_USD=1500
MAX_ORDER_USD=500
MAX_ORDERS_PER_RUN=40
LEVERAGE=5
ORDER_MODE=limit    # limit (maker, GTX) | market
LIMIT_ROUNDS=5      # so vong dat lai gia
LIMIT_WAIT_S=20     # giay cho moi vong
LIMIT_FALLBACK=1    # het vong ma lenh MO chua khop: 1 = thi truong, 0 = bo
MAX_GROSS_X=2
SAFETY_R=3
ALLOC_RSI2=8.0
ALLOC_XSMOM=1.0
RSI2_LAYERS=3       # so lop RSI(2) moi ma, 1 = khong mua them
RSI2_STOP_HVN=1     # cat lo RSI(2) o dinh khoi luong, 0 = 6×ATR
DELIST_BAN_DAYS=90  # chan mua ma co tin huy niem yet trong N ngay, 0 = tat
NEWS_PAPER=1        # so giay theo tin: do do tre + lenh ban khong GIA, khong dat lenh
NEWS_PAPER_USD=100  # co lenh gia de quy bps ra USD
# Khoa Binance RIENG, CHI bat "Enable Reading", cho WebSocket thong bao.
NEWS_API_KEY=
NEWS_API_SECRET=
START_EQUITY_USD=500
RUN_AT_UTC=00:05

# 1R = so USD rui ro moi lenh. Co von V thi diem khoi dau la 1R ~ V/300.
RISK_R_USD=2        # tài khoản test 500 USD
RISK_MAX_OPEN=33
